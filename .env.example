# AWS (AWS Academy also needs AWS_SESSION_TOKEN)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# IAM roles used by the batch pipeline
GLUE_JOB_ROLE_ARN=arn:aws:iam::<account-id>:role/<glue-job-role>
GLUE_CRAWLER_ROLE_ARN=arn:aws:iam::<account-id>:role/<glue-crawler-role>

# Kafka (streaming layer)
KAFKA_BOOTSTRAP_SERVERS=<host>:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=
